{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/property.schema.json",
  "title": "PropertyListingContract",
  "description": "Runtime data contract for a fictional residential property listing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "address",
    "zip_code",
    "price",
    "bedrooms",
    "bathrooms",
    "square_feet",
    "amenities",
    "image_src",
    "image_alt",
    "listing_url",
    "local_sponsors"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique synthetic identifier for the property."
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "street",
        "city",
        "state"
      ],
      "properties": {
        "street": {
          "type": "string",
          "minLength": 3
        },
        "city": {
          "type": "string",
          "minLength": 2
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "zip_code": {
      "type": "string",
      "pattern": "^[0-9]{5}(-[0-9]{4})?$",
      "description": "A five-digit or ZIP+4 postal code."
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 0
    },
    "bathrooms": {
      "type": "number",
      "minimum": 0
    },
    "square_feet": {
      "type": "integer",
      "minimum": 1
    },
    "amenities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "AIR_CONDITIONING",
          "CENTRAL_HEATING",
          "GARAGE_PARKING",
          "SWIMMING_POOL",
          "EV_CHARGING",
          "SOLAR_PANELS"
        ]
      }
    },
    "image_src": {
      "type": "string",
      "enum": [
        "/property-placeholder.svg"
      ],
      "description": "Local placeholder image used for synthetic property records."
    },
    "image_alt": {
      "type": "string",
      "minLength": 10
    },
    "listing_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://example\\.com/",
      "description": "A fictional example.com listing URL."
    },
    "local_sponsors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sponsor_id",
          "business_name",
          "tier",
          "target_url",
          "image_src",
          "image_alt"
        ],
        "properties": {
          "sponsor_id": {
            "type": "string",
            "format": "uuid"
          },
          "business_name": {
            "type": "string",
            "minLength": 2
          },
          "tier": {
            "type": "string",
            "enum": [
              "standard",
              "premium",
              "exclusive"
            ]
          },
          "target_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://example\\.com/"
          },
          "image_src": {
            "type": "string",
            "enum": [
              "/sponsor-market.svg",
              "/sponsor-repair.svg"
            ]
          },
          "image_alt": {
            "type": "string",
            "minLength": 10
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}